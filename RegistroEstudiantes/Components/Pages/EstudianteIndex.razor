@page "/"
@page "/Estudiante/Index"
@inject EstudiantesService estudiantesService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Registro de Estudiantes</PageTitle>

<div class="container mt-3">
    <div class="card shadow-lg">


        <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <h5 class="card-title mb-0">Registro de Estudiantes</h5>

            <a href="/Estudiante/Create" class="btn btn-primary">
                <i class="bi bi-plus-square"></i> Crear
            </a>
        </div>

        <div class="card-body">


            <div class="row g-2 mb-3">
                <div class="col-12 col-md-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" disabled selected>Elija un filtro</option>
                        <option value="Id">ID</option>
                        <option value="Nombre">Nombre</option>
                    </InputSelect>
                </div>

                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <InputText class="form-control"
                                   @bind-Value="ValorFiltro"
                                   placeholder="Buscar..." />

                        <button type="button"
                                class="btn btn-outline-primary"
                                @onclick="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>

 
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Edad</th>
                            <th class="text-center">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var estudiante in ListaEstudiantes)
                        {
                            <tr>
                                <td>@estudiante.EstudianteId</td>
                                <td>@estudiante.Nombres</td>
                                <td>@estudiante.Email</td>
                                <td>@estudiante.Edad</td>
                                <td class="text-center">
                                    <div class="d-flex flex-column flex-md-row gap-2 justify-content-center">
                                        <a href="/Estudiante/Edit/@estudiante.EstudianteId"
                                           class="btn btn-sm btn-primary">
                                            Editar
                                        </a>

                                        <button class="btn btn-sm btn-danger"
                                                @onclick="() => Eliminar(estudiante.EstudianteId)">
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>


        <div class="card-footer d-flex flex-column flex-md-row justify-content-between">
            <span>
                <strong>Cantidad:</strong> @ListaEstudiantes.Count()
            </span>

            <span>
                <strong>Promedio de Edad:</strong> @PromedioEdad.ToString("0.00")
            </span>
        </div>
    </div>
</div>

@code {

    public List<Estudiantes> ListaEstudiantes { get; set; } = new();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    public double PromedioEdad =>
        ListaEstudiantes.Any() ? ListaEstudiantes.Average(e => e.Edad) : 0;

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudiantesService.Listar(e => e.EstudianteId > 0);
    }

    private async Task Eliminar(int id)
    {
        var eliminado = await estudiantesService.Eliminar(id);

        if (eliminado)
            ListaEstudiantes = await estudiantesService.Listar(e => e.EstudianteId > 0);
    }

    private async Task Buscar()
    {
        if (!string.IsNullOrWhiteSpace(ValorFiltro))
        {
            if (Filtro == "Id" && int.TryParse(ValorFiltro, out int id))
            {
                ListaEstudiantes = await estudiantesService.Listar(e => e.EstudianteId == id);
            }
            else if (Filtro == "Nombre")
            {
                ListaEstudiantes = await estudiantesService.Listar(e =>
                    e.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
        else
        {
            ListaEstudiantes = await estudiantesService.Listar(e => e.EstudianteId > 0);
        }
    }
}
